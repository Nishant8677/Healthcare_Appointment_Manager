# Copy to backend/.env and fill in. Never commit the real .env.
# Every variable the backend reads is listed here.

# --- Application ---
# dev | test | prod. Controls fail-fast behaviour and log format (human vs JSON).
APP_ENV=dev
LOG_LEVEL=INFO

# --- Database ---
# Accepts postgres://, postgresql:// or postgresql+psycopg:// — the driver prefix is
# normalised at startup, so a managed-provider URL can be pasted in verbatim.
DATABASE_URL=postgresql+psycopg://ham:ham_local_dev@localhost:5432/healthcare
# Used only by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://ham:ham_local_dev@localhost:5432/healthcare_test
# Seconds to wait for a TCP connection before failing. Prevents an unreachable database from
# hanging a request indefinitely instead of returning an error.
DB_CONNECT_TIMEOUT_SECONDS=10

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# --- Booking ---
# IANA timezone the doctors' working hours are written in. Appointments themselves are
# always stored as UTC instants; this is only how wall-clock hours are interpreted.
CLINIC_TIMEZONE=UTC
# Minutes a slot stays reserved while the patient completes the symptom form.
SLOT_HOLD_MINUTES=5
# How far ahead patients may book.
BOOKING_HORIZON_DAYS=60

# --- Email delivery ---
# "console" logs messages instead of sending them: the default for local development so a
# misconfigured environment can never mail a real patient. "sendgrid" needs EMAIL_API_KEY and
# fails loudly at startup without it.
EMAIL_PROVIDER=console
# EMAIL_API_KEY=
EMAIL_FROM=clinic@example.com
EMAIL_FROM_NAME=The Clinic

# --- Background workers ---
# Gates every background worker (notifications, AI summaries, calendar sync). Turn off on
# web instances if you run a dedicated worker instance instead.
BACKGROUND_WORKERS_ENABLED=true
NOTIFICATION_POLL_SECONDS=15
NOTIFICATION_BATCH_SIZE=20
# Delivery attempts before a message is parked as failed for an admin to look at.
NOTIFICATION_MAX_ATTEMPTS=4
# How long before an appointment its reminder is sent.
REMINDER_LEAD_HOURS=24

# --- LLM summaries ---
# "stub" returns obviously-synthetic text so development and tests need no key and cost
# nothing. "gemini" and "anthropic" call a real model and require LLM_API_KEY — startup fails
# loudly without it rather than silently serving canned text as a clinical summary.
LLM_PROVIDER=stub
# LLM_API_KEY=
# Leave LLM_MODEL unset to get the provider's own default: gemini-3.7-flash for "gemini",
# claude-opus-5 for "anthropic". Set it only to pin a specific model.
# LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=4

# --- Medication reminders ---
# Reminders are derived from the prescription's structured fields, never from generated text.
# Long courses are capped so one prescription cannot queue thousands of messages.
MEDICATION_REMINDER_MAX_DAYS=14
MEDICATION_FIRST_DOSE_HOUR=8
MEDICATION_LAST_DOSE_HOUR=20

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Google Calendar ---
# Leave GOOGLE_CLIENT_ID unset to run without calendar sync. The feature is then inert, not
# broken: nobody can connect a calendar, no sync row is ever written, and every other part of
# the system behaves normally. Full setup steps: docs/google-calendar-setup.md
# GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# Must match a redirect URI registered on the OAuth client character for character.
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/callback
# Encrypts OAuth refresh tokens at rest. Required whenever GOOGLE_CLIENT_ID is set; startup
# fails without it rather than storing calendar credentials in plaintext.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CALENDAR_TOKEN_KEY=
# Where to send the browser after a successful connection. Unset returns JSON instead, which
# is what makes the flow testable with curl before a frontend exists.
# CALENDAR_RETURN_URL=http://localhost:5173/settings
GOOGLE_API_TIMEOUT_SECONDS=15
CALENDAR_STATE_TTL_MINUTES=10
CALENDAR_POLL_SECONDS=20
CALENDAR_BATCH_SIZE=20
CALENDAR_MAX_ATTEMPTS=5
# Upcoming appointments queued when a user connects, so connecting is not a no-op.
CALENDAR_BACKFILL_LIMIT=50

# --- Frontend (read at build time, not by the backend) ---
# Where the portals look for the API. Set as a build variable when deploying; a .env.local in
# frontend/ works for development. Baked into the bundle, so changing it needs a rebuild.
# VITE_API_BASE_URL=http://localhost:8000

# --- Deployment ---
# Set by the hosting platform. run.py binds 0.0.0.0:$PORT when APP_ENV=prod, and
# 127.0.0.1:8000 otherwise; both can be overridden here.
# HOST=0.0.0.0
# PORT=8000

# --- One-off commands (pass on the command line, never store here) ---
# Passwords for the CLI are read from the environment rather than from a flag, because a flag
# is visible in shell history and to anyone who can list processes.
#   ADMIN_PASSWORD='...' python -m app.cli create-admin --email a@clinic.com --name "Ops"
#   DEMO_PASSWORD='...'  python -m app.cli seed-demo
